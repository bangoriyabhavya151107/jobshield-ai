# Copy this file to .env and add your Supabase browser-safe values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Never put GEMINI_API_KEY or the Supabase service-role key in this file.
# Store Gemini secrets only in Supabase Edge Function secrets.
